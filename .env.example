# Wird von install.sh nach ".env" kopiert. Keys eintragen, ".env" NIE auf GitHub hochladen.
# Mehrere Keys pro Anbieter mit Komma trennen -> automatische Rotation bei Limit (429).

# Claude (API-Key von console.anthropic.com, Modelle waehlst du pro Agent: Sonnet, Haiku, Opus ...)
ANTHROPIC_API_KEY=
# ChatGPT (API-Key von platform.openai.com)
OPENAI_API_KEY=
# OpenRouter: ein Key fuer hunderte Modelle (Claude, GPT, Gemini, DeepSeek, Qwen, Llama ...)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Ollama (lokal auf dem Pi, optional)
# Laeuft Ollama auf einem anderen Rechner (z.B. Laptop), dessen Adresse eintragen und dort OLLAMA_HOST=0.0.0.0 setzen.
# OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5:3b
# PCL_SITE_HOST=127.0.0.1       # Veroeffentlichte Webseiten: nur Pi (Standard) oder 0.0.0.0 fuer das Netz
# PCL_SITE_PORT_BASE=8800       # erster Port fuer veroeffentlichte Webseiten
# PCL_TZ=Europe/Vienna          # Zeitzone fuer Oeffnungszeiten/Zeitplaene, falls die Systemzeit nicht passt
# PCL_MAX_RESUMES=2             # Wiederaufnahmen je gescheiterter Aufgabe bei Arbeitsbeginn
# PCL_MODEL_CHECK_HOURS=6      # Modell-Pruefung gegen die Anbieter-Listen (0 = aus); Warnung per Telegram + Menue ⚠ Modelle
# OLLAMA_TIMEOUT=900          # Sekunden je Antwort (lokale Modelle sind auf dem Pi langsam)

# --- Zugang ---
# Passwort fuer die Login-Seite (install.sh setzt ein zufaelliges). Mindestens 12 Zeichen,
# sobald die App von aussen erreichbar ist.
APP_TOKEN=

# Standard: nur lokal (127.0.0.1). Fuer Tailscale/Cloudflare Tunnel bleibt das so.
# HOST=0.0.0.0
# PORT=8787

# 1 = die App steht hinter Tailscale Serve / Cloudflare Tunnel / Reverse-Proxy
# (liest Client-IP aus Headern, setzt Cookie als "Secure"). Erzwingt ein starkes Passwort.
# TRUST_PROXY=1

# --- Telegram (optional): Post vom Chef aufs Handy, per Antwort neu bearbeiten / erledigen / neuer Auftrag ---
# 1) In Telegram mit @BotFather einen Bot anlegen -> Token hier eintragen
# 2) PaperclipLite starten, dem Bot /start schreiben -> er nennt deine Chat-ID -> hier eintragen, neu starten
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Internet-Werkzeuge der Agenten (Websuche, Seiten lesen, Bilder) ---
# Laufen ohne Key (DuckDuckGo-Suche, Openverse-Bilder, Pollinations-Bildgenerator). Bessere Qualitaet mit eigenem Key:
# PCL_ALLOW_WEB=0            # sperrt ALLE Internet-Werkzeuge serverseitig
# SEARXNG_URL=http://127.0.0.1:8080   # eigene Metasuche (beste Datenschutz-Loesung)
# BRAVE_API_KEY=             # oder TAVILY_API_KEY=
# PEXELS_API_KEY=            # Fotos von Pexels statt Openverse
# IMAGE_PROVIDER=openai      # pollinations (Standard) | gemini (GEMINI_API_KEY) | openai (OPENAI_API_KEY) | openrouter (OPENROUTER_API_KEY)
# OPENAI_API_KEY=            # nur fuer IMAGE_PROVIDER=openai; Referenzbilder laufen ueber den Bearbeiten-Endpunkt (wie ChatGPT)
# OPENROUTER_API_KEY=        # nur fuer IMAGE_PROVIDER=openrouter (ein Guthaben fuer viele Bildmodelle, Std. google/gemini-2.5-flash-image)
# IMAGE_MODEL=               # optional; Standard gemini-2.5-flash-image bzw. gpt-image-1 (neuer bei Gemini: gemini-nano-banana-2.1)
# IMAGE_SIZE=                # optional, nur Gemini: 1K | 2K | 4K
# IMAGE_QUALITY=             # optional, nur OpenAI: low | medium | high (high kostet deutlich mehr)
# PCL_MAX_TOOL_STEPS=6
# Videoclips per KI (Werkzeug video_generate, Recht "Medien"). Standard: aus. Kostet pro Sekunde Video ueber GEMINI_API_KEY
# (ein Google-One-/Flow-Abo zaehlt hier nicht). Flow selbst hat keine API, das Modell dahinter schon.
# VIDEO_PROVIDER=gemini
# VIDEO_MODEL=gemini-omni-1.1-flash   # Standard; oder ein Veo-Modell, z.B. veo-3.1-fast-generate-001
# PCL_VIDEO_TIMEOUT=900               # Sekunden je Clip       # Werkzeug-Runden pro Lauf

# --- Medien (Video, Sprache, Dokumente) ---
# Systempakete: sudo apt install ffmpeg espeak-ng fonts-dejavu-core
# TTS_ENGINE=auto            # auto | espeak | piper | edge
# PIPER_MODEL=/pfad/zur/stimme.onnx   # Piper = deutlich bessere Offline-Stimme als espeak (pip install piper-tts)
# EDGE_VOICE=de-AT-IngridNeural       # nur mit TTS_ENGINE=edge und pip install edge-tts (inoffizieller Online-Dienst)
# PCL_FFMPEG_TIMEOUT=3600    # Sekunden je Videoschritt (Pi ist langsam: 1 Min Video = mehrere Minuten Rechenzeit)
# PCL_MAX_UPLOAD_MB=500      # Upload-Limit fuer eigene Dateien
# PCL_MAX_DOWNLOAD_MB=60     # Limit fuer Downloads der Agenten (PDFs, Medien)
# PCL_MAX_OUTPUT=0           # max. Ausgabe-Tokens je Modellantwort (0 = Standard, Claude: 8192)

# --- Echter Browser (browse_page, Recht "web"): ./install.sh --browser ---
# PCL_BROWSER=0              # 0 = Browser-Werkzeug aus, auch wenn Playwright installiert ist
# PCL_BROWSER_PATH=/usr/bin/chromium   # eigenes Chromium statt dem von Playwright (z. B. 32-Bit-System)
# PCL_BROWSER_TIMEOUT=30     # Sekunden je Seite

# --- Code ausfuehren (Recht "run_code", je Agent einschalten): ./install.sh --run (bubblewrap) ---
# Abgeschottet: kein Internet, nur /usr und der Projektordner (nur lesen) sichtbar, keine Keys, Ergebnisse in output/run/
# PCL_ALLOW_RUN=0            # 0 = global gesperrt
# PCL_RUN_TIMEOUT=60         # Sekunden je Lauf
# PCL_RUN_MEM_MB=1024        # RAM-Grenze je Lauf (Adressraum)

# --- Gefaehrliche Faehigkeiten (Standard: aus) ---
# Shell-Befehle nach manueller Freigabe ausfuehren. Wer das Passwort hat, kann dann Befehle auf dem Pi freigeben!
# PCL_ALLOW_SHELL=1
# CLI-Agenten (z.B. "claude -p") erlauben
# PCL_ALLOW_CLI=1
# Eingebaute CLI-Anbieter nutzen dein Abo statt API-Key (Programme muessen auf dem Pi installiert und angemeldet sein):
#   "Claude (CLI)"  -> claude -p --tools "" --strict-mcp-config --no-session-persistence         (Befehl aenderbar: PCL_CLI_CLAUDE=...)
#   "ChatGPT (Codex-CLI)" -> codex exec --skip-git-repo-check --ephemeral -     (Befehl aenderbar: PCL_CLI_CODEX=...)
# PCL_CLI_TIMEOUT=600         # Sekunden je Antwort

# Maximale Delegationstiefe (CEO -> CTO -> Dev -> ...)
# PCL_MAX_DEPTH=8

# --- OCR (gescannte PDFs und Bilder lesen; braucht: sudo apt install tesseract-ocr tesseract-ocr-deu poppler-utils) ---
# PCL_OCR_LANG=deu+eng        # Standard: alle installierten aus deu, eng, tur
# PCL_OCR_MAX_PAGES=25        # Seiten je Scan (OCR ist auf dem Pi langsam, ca. 5-15 s/Seite)
# PCL_OCR_IMAGES=0            # 0 = Bilder nicht per OCR lesen
# PCL_RUN_MAX_IMAGES=8        # Bilder, die ein Agent in einem Auftrag gleichzeitig sieht (view_image, Selbstkontrolle)
# PCL_SELF_CHECKS=1           # erzeugte PDFs als Bild gegen den Auftrag pruefen lassen (0 = aus)

# --- Sprachausgabe: Piper wird nach "./install.sh --piper" automatisch genutzt (models/piper/*.onnx) ---
# TTS_ENGINE=auto             # auto | piper | espeak | edge
# PIPER_MODEL=/pfad/zur/stimme.onnx   # nur noetig fuer eine andere Stimme
